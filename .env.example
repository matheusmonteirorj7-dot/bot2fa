# Token do bot criado no Discord Developer Portal — nunca publique este valor.
DISCORD_TOKEN=COLOQUE_O_TOKEN_LOCALMENTE

# Application ID do app Discord.
CLIENT_ID=COLOQUE_O_APPLICATION_ID

# Opcional, mas recomendado para registrar o comando imediatamente no servidor de teste.
GUILD_ID=COLOQUE_O_ID_DO_SERVIDOR
